{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": true
  },
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "includeFiles": "{data/journal/**,index.html}"
    },
    "api/scan.py": {
      "includeFiles": "src/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index?probe=dashboard"
    },
    {
      "source": "/index.html",
      "destination": "/api/index?probe=dashboard"
    },
    {
      "source": "/api/health",
      "destination": "/api/index?probe=health"
    },
    {
      "source": "/api/binance-health",
      "destination": "/api/index?probe=binance"
    },
    {
      "source": "/api/state-health",
      "destination": "/api/index?probe=state-health"
    },
    {
      "source": "/api/persistence-probe",
      "destination": "/api/index?probe=persistence"
    },
    {
      "source": "/api/state",
      "destination": "/api/index?probe=state"
    }
  ]
}
