{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "includeFiles": "data/journal/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/binance-health",
      "destination": "/api/index.py"
    }
  ]
}
