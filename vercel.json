{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": true
  },
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/scheduler.py": {
      "includeFiles": "src/**",
      "maxDuration": 60
    },
    "api/dashboard.py": {
      "includeFiles": "{api/index.py,index.html}"
    },
    "api/index.py": {
      "includeFiles": "{data/journal/**,index.html}"
    },
    "api/scan.py": {
      "includeFiles": "src/**",
      "maxDuration": 60
    },
    "api/research.py": {
      "includeFiles": "{src/**,api/scan.py}",
      "maxDuration": 60
    },
    "api/dashboard_data.py": {
      "includeFiles": "{src/dashboard_view.py,api/index.py}"
    }
  },
  "routes": [
    {
      "src": "^/api/scheduler$",
      "dest": "/api/scheduler.py"
    },
    {
      "src": "^/api/dashboard-meta$",
      "dest": "/api/dashboard_data.py?kind=meta"
    },
    {
      "src": "^/api/dashboard-latest$",
      "dest": "/api/dashboard_data.py?kind=view"
    },
    {
      "src": "^/$",
      "dest": "/api/dashboard.py"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/api/dashboard.py"
    },
    {
      "src": "^/api/scan$",
      "dest": "/api/scan.py"
    },
    {
      "src": "^/api/research$",
      "dest": "/api/research.py"
    },
    {
      "src": "^/api/health$",
      "dest": "/api/index.py?probe=health"
    },
    {
      "src": "^/api/binance-health$",
      "dest": "/api/index.py?probe=binance"
    },
    {
      "src": "^/api/state-health$",
      "dest": "/api/index.py?probe=state-health"
    },
    {
      "src": "^/api/persistence-probe$",
      "dest": "/api/index.py?probe=persistence"
    },
    {
      "src": "^/api/state$",
      "dest": "/api/index.py?probe=state"
    },
    {
      "handle": "filesystem"
    }
  ]
}
