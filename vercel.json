{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "includeFiles": "data/journal/**"
    },
    "api/scan.py": {
      "includeFiles": "src/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/api/health",
      "destination": "/api/index.py?probe=health"
    },
    {
      "source": "/api/binance-health",
      "destination": "/api/index.py?probe=binance"
    }
  ]
}
