{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": true
  },
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "includeFiles": "{data/journal/**,index.html}"
    },
    "api/scan.py": {
      "includeFiles": "src/**",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/index.py?probe=dashboard"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/api/index.py?probe=dashboard"
    },
    {
      "src": "^/api/scan$",
      "dest": "/api/scan.py"
    },
    {
      "src": "^/api/health$",
      "dest": "/api/index.py?probe=health"
    },
    {
      "src": "^/api/binance-health$",
      "dest": "/api/index.py?probe=binance"
    },
    {
      "src": "^/api/state-health$",
      "dest": "/api/index.py?probe=state-health"
    },
    {
      "src": "^/api/persistence-probe$",
      "dest": "/api/index.py?probe=persistence"
    },
    {
      "src": "^/api/state$",
      "dest": "/api/index.py?probe=state"
    },
    {
      "handle": "filesystem"
    }
  ]
}
