# Configure locally or in the deployment environment; never commit actual values.
CSR_SCAN_TOKEN=
CSR_WORKER_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
CSR_STATE_KEY=crypto-state-radar:preview:state:v1
CSR_RESEARCH_DATABASE_URL=
# Must match VERCEL_ENV when deployed (preview or production).
CSR_RESEARCH_ENVIRONMENT=preview
CSR_RESEARCH_WORKER_URL=
# Default on Vercel is shadow. Production switching is an explicit release step.
CSR_SCAN_MODE=shadow
# Optional read-only Binance data key for V3 Top Trader market-data endpoints.
# Never expose this in the browser, raw archive, logs or committed values.
CSR_BINANCE_DATA_API_KEY=
