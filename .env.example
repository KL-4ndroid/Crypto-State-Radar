# Configure locally or in the deployment environment; never commit actual values.
CSR_SCAN_TOKEN=
CSR_WORKER_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
CSR_STATE_KEY=crypto-state-radar:preview:state:v1
CSR_RESEARCH_DATABASE_URL=
# Must match VERCEL_ENV when deployed (preview or production).
CSR_RESEARCH_ENVIRONMENT=preview
CSR_RESEARCH_WORKER_URL=
# Default on Vercel is shadow. Production switching is an explicit release step.
CSR_SCAN_MODE=shadow
# Versioned algorithm selection. V3.3 research is not yet enabled for live scans.
# Unknown or unreleased selections fail before market requests; no silent fallback.
CSR_ALGORITHM_ID=radar-v2
# BSC cutover: set product=bsc and algorithm=bsc-discovery together only after
# publishing an isolated BSC read view. Existing Futures history is retained.
CSR_PRODUCT_MODE=futures
CSR_BSC_RPC_URLS=https://bsc-rpc.publicnode.com
# Optional; default is bsc:<database environment>:readonly-v1.
CSR_BSC_STREAM=
# Continuous local tracking requires an explicit comma-separated watchlist.
CSR_BSC_DISCOVERY_MODE=blocks
CSR_BSC_WATCH_ADDRESSES=
# Optional read-only Binance data key for V3 Top Trader market-data endpoints.
# Never expose this in the browser, raw archive, logs or committed values.
CSR_BINANCE_DATA_API_KEY=
